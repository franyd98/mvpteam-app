<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.proyectoweb.upload-videos</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/fran/Documents/ProyectoAPPWEB/scripts/run_upload.sh</string>
    </array>

    <!-- Ejecutar cada día a las 16:00 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>16</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Si el Mac estaba apagado/dormido a las 19:00, ejecutar al despertar -->
    <key>StartOnMount</key>
    <false/>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/fran/Documents/ProyectoAPPWEB/scripts/upload_launchd.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/fran/Documents/ProyectoAPPWEB/scripts/upload_launchd.log</string>
</dict>
</plist>
